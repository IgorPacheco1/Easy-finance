# Modelo das variáveis de ambiente do desenvolvimento local.
# Copie para .env (que é ignorado pelo Git) e troque a senha:
#   Copy-Item .env.example .env     (PowerShell)
#   cp .env.example .env            (Linux/macOS/Git Bash)
#
# Nunca coloque senhas reais neste arquivo: ele é versionado.

# PostgreSQL (usado pelo compose.yaml e pelo perfil dev do backend)
# Dois usuários do banco (ADR-0034):
# - POSTGRES_USER: dono das tabelas, usado só pelas migrations (Flyway);
# - guarda_app: o que o app usa, só lê e grava dados. A senha dele vem de GUARDA_APP_PASSWORD.
# Use senhas diferentes para os dois.
POSTGRES_DB=guarda
POSTGRES_USER=guarda_admin
POSTGRES_PASSWORD=troque-esta-senha
GUARDA_APP_PASSWORD=troque-esta-outra-senha
POSTGRES_PORT=5432
