# Modelo das variáveis de ambiente do desenvolvimento local.
# Copie para .env (que é ignorado pelo Git) e troque a senha:
#   Copy-Item .env.example .env     (PowerShell)
#   cp .env.example .env            (Linux/macOS/Git Bash)
#
# Nunca coloque senhas reais neste arquivo: ele é versionado.

# PostgreSQL (usado pelo compose.yaml)
POSTGRES_DB=easyfinance
POSTGRES_USER=easyfinance
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432
