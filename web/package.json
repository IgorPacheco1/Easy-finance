{
  "name": "easy-finance-web",
  "private": true,
  "version": "0.5.0-SNAPSHOT",
  "description": "PWA do Easy Finance (React + TypeScript + Vite)",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "dev:celular": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "preview:celular": "vite preview --host",
    "api:tipos": "npx -y openapi-typescript@7.13.0 http://127.0.0.1:8080/v3/api-docs -o src/api/esquema.d.ts"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^31.0.0",
    "msw": "^3.0.4",
    "oxlint": "^1.92.0",
    "prettier": "3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "overrides": {
    "workbox-build": {
      "glob": "14.0.3"
    }
  }
}
