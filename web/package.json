{
  "name": "easy-finance-web",
  "private": true,
  "version": "0.0.0",
  "description": "PWA do Easy Finance (React + TypeScript + Vite)",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "dev:celular": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "api:tipos": "npx -y openapi-typescript@7.13.0 http://localhost:8080/v3/api-docs -o src/api/esquema.d.ts"
  },
  "dependencies": {
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "msw": "^3.0.3",
    "oxlint": "^1.89.0",
    "prettier": "3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
