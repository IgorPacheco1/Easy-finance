# Configuração do Lombok para este projeto (ver docs/adr/0009-uso-do-lombok.md).

# Este é o arquivo raiz: não procura configurações em pastas acima.
config.stopBubbling = true

# Marca o código gerado com @Generated, para o JaCoCo não contar getters/setters
# gerados na cobertura de testes (#15).
lombok.addLombokGeneratedAnnotation = true

# @Data, @EqualsAndHashCode e @ToString causam bugs em entidades JPA
# (relacionamentos lazy, Set quebrado, loop infinito). Proibidos no projeto todo.
lombok.data.flagUsage = error
lombok.equalsAndHashCode.flagUsage = error
lombok.toString.flagUsage = error
